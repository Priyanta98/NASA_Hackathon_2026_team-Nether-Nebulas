# SPHEREx ChronoSky Environment Configuration Template
# Copy this file to .env if you want to override defaults (no API key is required for NASA/IPAC IRSA)

# NASA/IPAC IRSA Archive Endpoint (Public SIA2 & TAP)
IRSA_BASE_URL=https://irsa.ipac.caltech.edu

# Optional MongoDB Atlas Connection URI (falls back automatically to data/tracklets_store.json if blank)
MONGODB_URI=
MONGODB_DB_NAME=spherex_chronosky

# Continuous Background Evaluator Sweep Interval (seconds)
SWEEP_INTERVAL_SECONDS=900
PORT=8000